---
// Wiesn Walk is now Wiesen Sim. This tiny app keeps the old address (/wiesnwalk) and sends visitors on to /wiesensim.
const base = import.meta.env.BASE_URL;
const target = '/wiesensim/';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Wiesen Sim — moved</title>
<meta name="robots" content="noindex">
<link rel="canonical" href="https://www.nassau.se/wiesensim/">
<meta http-equiv="refresh" content={`0; url=${target}`}>
<script is:inline define:vars={{ target }}>location.replace(target + location.search + location.hash);</script>
<style>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#0b0c10;color:#f4ecd8;font:16px/1.5 system-ui,sans-serif}a{color:#f0c75a}</style>
</head>
<body><p>Wiesn Walk is now <a href={target}>Wiesen Sim</a>.</p></body>
</html>
